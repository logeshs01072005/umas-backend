# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# PostgreSQL — Render/Railway will give you this connection string
DATABASE_URL=postgresql://user:password@host:5432/umas_boutique
DATABASE_SSL=true

# Auth
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Admin seed account (created automatically on first migrate/seed)
ADMIN_NAME=Uma Admin
ADMIN_EMAIL=admin@umas.com
ADMIN_PASSWORD=change_this_admin_password

# Razorpay (get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Free shipping threshold (in paise-free rupees) and flat shipping fee
FREE_SHIPPING_THRESHOLD=2999
FLAT_SHIPPING_FEE=99

# SMTP / Email (for password reset emails)
# Example using Gmail SMTP or any SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Optional: from address
SMTP_FROM="Uma's Boutique <no-reply@umas.com>"
